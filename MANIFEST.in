include LICENSE README.md CHANGELOG.md ROADMAP.md CONTRIBUTING.md TASKS.md
recursive-include docs *.md
recursive-include demo *.py
recursive-include tests *.py
recursive-include scripts *.py
recursive-include assets *.css
include manage.py package.json package-lock.json
include DEMARRER.ps1
recursive-include docs/screenshots *.png
recursive-include .github *.yml
recursive-include django_project_manager/templates *.html
recursive-include django_project_manager/static *
recursive-include django_project_manager/schemas *.json
global-exclude *.py[cod]
